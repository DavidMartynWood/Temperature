{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lake-temperature",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "lake_temperature_db",
			"database_name": "lake-temperature-db",
			"database_id": "89f17196-6ad4-4005-8ac5-714f946b7071"
		}
	],
	// PR preview deployments: separate Worker, same prod D1 database, writes disabled in code.
	"env": {
		"dev": {
			"name": "lake-temperature-dev",
			"vars": { "READ_ONLY": "true" },
			"d1_databases": [
				{
					"binding": "lake_temperature_db",
					"database_name": "lake-temperature-db",
					"database_id": "89f17196-6ad4-4005-8ac5-714f946b7071"
				}
			]
		}
	}
}