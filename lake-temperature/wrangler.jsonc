{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lake-temperature",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public",
		"binding": "ASSETS",
		// Lets the Worker pre-render the latest temperature into the home page.
		"run_worker_first": ["/"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Cron is UTC; May-September is always BST, so 07:00 and 15:00 UTC are 08:00 and 16:00 UK time.
	// The Worker re-checks UK time. Triggers are not inherited by the dev and qa environments.
	"triggers": {
		"crons": ["0 7 * 5-9 6", "0 15 * 5-9 3"]
	},
	"d1_databases": [
		{
			"binding": "lake_temperature_db",
			"database_name": "lake-temperature-db",
			"database_id": "89f17196-6ad4-4005-8ac5-714f946b7071"
		},
		{
			"binding": "lake_temperature_qa_db",
			"database_name": "lake-temperature-qa-db",
			"database_id": "a38de82c-ac9d-4e96-87a3-1ec7b4ae0d94"
		}
	],
	// PR preview deployments: separate Worker, same prod D1 database, writes disabled in code.
	"env": {
		"dev": {
			"name": "lake-temperature-dev",
			"vars": {
				"READ_ONLY": "true"
			},
			"d1_databases": [
				{
					"binding": "lake_temperature_db",
					"database_name": "lake-temperature-db",
					"database_id": "89f17196-6ad4-4005-8ac5-714f946b7071"
				}
			]
		},
		// QA: separate Worker with its own D1 database pre-populated with the last year of readings.
		// Create the database with `npx wrangler d1 create lake-temperature-qa-db` and replace database_id below.
		"qa": {
			"name": "lake-temperature-qa",
			"vars": {
				"READ_ONLY": "true",
				"EARLIEST_HISTORY_DATE": "2025-01-01"
			},
			"d1_databases": [
				{
					"binding": "lake_temperature_db",
					"database_name": "lake-temperature-qa-db",
					"database_id": "a38de82c-ac9d-4e96-87a3-1ec7b4ae0d94",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}